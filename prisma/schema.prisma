// ============================================================================
// MCI PLATFORM — Campeonato Brasileiro Muscle Contest
//
// Domínio: esporte, atletas, competições, comunidade, conteúdo e comunicação.
// NÃO existe camada financeira: nenhuma tabela, coluna ou enum representa
// dinheiro, cobrança, pagamento, cupom, reembolso ou saldo. A ausência é
// deliberada e verificada por teste (tests/financeiro-ausente.test.mjs).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ORGANIZAÇÕES (multi-tenancy)
// ============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Fuso do tenant. Eventos podem sobrescrever; nada no código assume
  // America/Sao_Paulo por conta própria.
  timezone  String   @default("America/Sao_Paulo")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  affiliations     Affiliation[]
  athletes         Athlete[]
  events           Event[]
  teams            Team[]
  gyms             Gym[]
  brands           Brand[]
  sponsors         Sponsor[]
  seasons          RankingSeason[]
  muscleWarImports MuscleWarImport[]

  @@index([active])
  athleteIdentities AthleteIdentity[]
  classCatalog ClassCatalog[]
  companies Company[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, role])
  @@index([userId])
  @@index([organizationId, role])
}

// ============================================================================
// USUÁRIOS E ACESSO
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EVENT_DIRECTOR
  EVENT_COORDINATOR
  JUDGE_COORDINATOR
  JUDGE
  STAFF
  REGISTRATION_OPERATOR
  CHECKIN_OPERATOR
  WEIGHIN_OPERATOR
  RESULTS_OPERATOR
  RANKING_MANAGER
  SOCIAL_ADMIN
  MODERATOR
  ATHLETE
  COACH
  GYM
  TEAM
  BRAND
  SPONSOR
  MEDIA
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  // Papel global. Papéis por organização vivem em OrganizationMember; a
  // autorização efetiva é a união dos dois, resolvida em utils/permissions.
  role         UserRole   @default(ATHLETE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships   OrganizationMember[]
  athlete       Athlete?             @relation("AthleteUser")
  socialProfile SocialProfile?
  coach         Coach?
  notifications Notification[]
  auditLogs     AuditLog[]           @relation("AuditActor")

  createdEvents          Event[]             @relation("EventCreatedBy")
  createdAthletes        Athlete[]           @relation("AthleteCreatedBy")
  createdRegistrations   Registration[]      @relation("RegistrationCreatedBy")
  cancelledRegistrations Registration[]      @relation("RegistrationCancelledBy")
  checkInsOperated       CheckIn[]           @relation("CheckInOperator")
  weighInsOperated       WeighIn[]           @relation("WeighInOperator")
  credentialScans        CredentialScan[]    @relation("CredentialScanner")
  panelSeats             PanelJudge[]
  scoresGiven            JudgingScore[]      @relation("ScoreJudge")
  resultsPublished       Result[]            @relation("ResultPublishedBy")
  resultVersions         ResultVersion[]     @relation("ResultVersionAuthor")
  uploadedDocuments      AthleteDocument[]   @relation("DocumentUploader")
  eventDocuments         EventDocument[]     @relation("EventDocumentUploader")
  muscleWarImports       MuscleWarImport[]   @relation("ImportCreatedBy")
  muscleWarApplied       MuscleWarImport[]   @relation("ImportAppliedBy")
  moderationActions      ContentReport[]     @relation("ReportResolver")
  proHistoryEntries      AthleteProHistory[] @relation("ProHistoryAuthor")

  @@index([role])
  @@index([status])
  rankingPointsAwarded RankingPoint[]      @relation("RankingPointAwardedBy")
  overallTitlesDeclared EventOverallTitle[] @relation("OverallDeclaredBy")
  membershipsCreated AthleteTeamMembership[] @relation("MembershipCreatedBy")
  membershipsEnded   AthleteTeamMembership[] @relation("MembershipEndedBy")
}

// ============================================================================
// FILIAÇÃO ESPORTIVA
//
// A filiação é o vínculo esportivo formal do atleta com a entidade responsável
// por ele. É uma das chaves do matching com o MuscleWar, por isso `code` é
// estável e único dentro da organização.
// ============================================================================

enum AffiliationKind {
  FEDERATION
  ENTITY
  ASSOCIATION
  TEAM
  OTHER
}

model Affiliation {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  code           String
  kind           AffiliationKind @default(ENTITY)
  state          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athletes      Athlete[]
  registrations Registration[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

// ============================================================================
// ATLETAS
// ============================================================================

enum Sex {
  MALE
  FEMALE
}

enum ProStatus {
  NONE
  ACTIVE
  INACTIVE
  SUSPENDED
  RETIRED
}

model Athlete {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?   @unique
  fullName       String
  stageName      String?
  birthDate      DateTime?
  sex            Sex
  country        String    @default("BR")
  state          String?
  city           String?
  phone          String?
  email          String?
  photoKey       String?
  athleteNumber  String?
  affiliationId  String?
  teamId         String?
  coachId        String?
  gymId          String?
  proStatus      ProStatus @default(NONE)
  proSince       DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("AthleteUser", fields: [userId], references: [id], onDelete: SetNull)
  affiliation  Affiliation? @relation(fields: [affiliationId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  coach        Coach?       @relation(fields: [coachId], references: [id], onDelete: SetNull)
  gym          Gym?         @relation(fields: [gymId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("AthleteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  registrations     Registration[]
  documents         AthleteDocument[]
  proHistory        AthleteProHistory[]
  resultEntries     ResultEntry[]
  rankingPoints     RankingPoint[]
  rankings          Ranking[]
  externalResults   ExternalResult[]
  muscleWarItems    MuscleWarImportItem[]
  socialProfile     SocialProfile?
  sponsorships      Sponsorship[]
  brandPartnerships AthleteBrandPartnership[]
  identity          AthleteIdentity?

  @@unique([organizationId, athleteNumber])
  @@index([organizationId, fullName])
  @@index([organizationId, proStatus])
  @@index([affiliationId])
  @@index([teamId])
  @@index([coachId])
  overallTitles EventOverallTitle[]
  teamMemberships AthleteTeamMembership[]
}

enum DocumentKind {
  ID
  MEDICAL
  TERM
  AFFILIATION_PROOF
  OTHER
}

/// CPF do atleta, em tabela própria.
///
/// O RLS do PostgreSQL é barreira de LINHA, não de coluna: onde a política
/// libera a linha, libera todas as colunas dela. Enquanto o CPF morava em
/// "Athlete" — cuja política precisa liberar leitura anônima para o diretório
/// público de atletas, o ranking e a página pública de evento funcionarem —
/// quem impedia o número de sair era a projeção do service, e só ela.
///
/// Separando o dado sensível em uma linha própria, a barreira de linha passa a
/// protegê-lo de verdade: a política desta tabela não tem predicado anônimo e
/// exige operador da organização ou o próprio atleta. Um SELECT * feito por
/// engano numa rota pública não tem como trazer CPF, porque a linha não vem.
model AthleteIdentity {
  athleteId      String   @id
  organizationId String
  /// CPF normalizado (11 dígitos). A unicidade por organização é o que impede
  /// o mesmo atleta virar dois cadastros.
  cpf            String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  athlete      Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, cpf])
  @@index([cpf])
}

/// Vínculo do atleta com uma equipe — histórico completo, não só o estado atual.
///
/// TRAVA DE INTEGRIDADE: um atleta não pode ter dois vínculos ativos ao mesmo
/// tempo. A garantia é do BANCO, não da tela: `activeAthleteId` carrega o id do
/// atleta enquanto o vínculo está aberto e NULL depois de encerrado, e o índice
/// único sobre ela recusa o segundo vínculo — inclusive quando dois treinadores
/// tentam ao mesmo tempo, caso em que um dos INSERTs perde a corrida e recebe
/// violação de unicidade.
///
/// No PostgreSQL, NULL não conflita com NULL: vínculos encerrados se acumulam
/// livremente, e é por isso que o histórico pode ser preservado sem afrouxar a
/// trava.
///
/// Trocar de equipe não é apagar e recriar: o vínculo anterior é ENCERRADO com
/// data, autor e motivo, e o novo é criado por quem tem permissão de operador.
/// Assim ninguém apaga o passado do atleta.
model AthleteTeamMembership {
  id        String    @id @default(cuid())
  athleteId String
  teamId    String
  /// Empresa da equipe no início do vínculo, registrada como estava.
  companyId String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  reason    String?
  /// Igual a `athleteId` enquanto ativo; NULL quando encerrado. É esta coluna,
  /// e o único sobre ela, que impedem o segundo vínculo simultâneo.
  activeAthleteId String? @unique
  createdById String?
  endedById   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  endedBy   User?    @relation("MembershipEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([athleteId, startedAt])
  @@index([teamId])
}

model AthleteDocument {
  id           String       @id @default(cuid())
  athleteId    String
  kind         DocumentKind @default(OTHER)
  title        String
  fileName     String
  mimeType     String       @default("application/octet-stream")
  storageKey   String       @unique
  sizeBytes    Int          @default(0)
  uploadedById String?
  createdAt    DateTime     @default(now())

  athlete    Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([athleteId, kind])
}

model AthleteProHistory {
  id          String    @id @default(cuid())
  athleteId   String
  status      ProStatus
  reason      String
  eventId     String?
  title       String?
  effectiveAt DateTime  @default(now())
  createdById String?
  createdAt   DateTime  @default(now())

  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("ProHistoryAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([athleteId, effectiveAt])
}

// ============================================================================
// EQUIPES, COACHES, ACADEMIAS
// ============================================================================

/// Empresa que compete entrando com suas equipes.
///
/// Fica ACIMA da equipe: a empresa se cadastra, inscreve uma ou mais equipes, e
/// os pontos sobem por essa cadeia —
///
///   atleta → equipe → empresa
///
/// REGRA HOMOLOGADA: a mesma tabela de pontos e o mesmo desempate valem para
/// atleta, equipe e empresa. Não há peso, multiplicador nem bônus próprio de
/// empresa, e a pontuação continua rastreável até o resultado de cada atleta.
model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  city           String?
  state          String?
  /// Empresa desativada não recebe equipes novas; o histórico dela permanece.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams         Team[]
  rankingPoints RankingPoint[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  memberships AthleteTeamMembership[]
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  /// Empresa que inscreveu a equipe. Opcional: uma equipe pode competir sem
  /// empresa por trás, e nesse caso ela simplesmente não pontua para nenhuma.
  companyId      String?
  name           String
  city           String?
  state          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  athletes      Athlete[]
  socialProfile SocialProfile?
  sponsorships  Sponsorship[]

  @@unique([organizationId, name])
  rankingPoints RankingPoint[]
  memberships AthleteTeamMembership[]
}

model Coach {
  id        String   @id @default(cuid())
  userId    String?  @unique
  name      String
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  athletes      Athlete[]
  socialProfile SocialProfile?
}

model Gym {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  city           String?
  state          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athletes      Athlete[]
  socialProfile SocialProfile?

  @@unique([organizationId, name])
}

// ============================================================================
// EVENTOS → CATEGORIAS → DIVISÕES → CLASSES
// ============================================================================

enum EventStatus {
  DRAFT
  PLANNED
  REGISTRATIONS_OPEN
  REGISTRATIONS_CLOSED
  IN_OPERATION
  IN_JUDGING
  RESULTS_IN_REVIEW
  RESULTS_PUBLISHED
  CLOSED
  CANCELLED
}

model Event {
  id               String      @id @default(cuid())
  organizationId   String
  name             String
  slug             String      @unique
  description      String?
  status           EventStatus @default(DRAFT)
  // Fuso do evento. Sem isto, chamada de palco e pesagem seriam exibidas no
  // fuso do servidor.
  timezone         String      @default("America/Sao_Paulo")
  startDate        DateTime?
  endDate          DateTime?
  venue            String?
  city             String?
  state            String?
  seasonId         String?
  scoringRuleSetId String?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  season         RankingSeason?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  scoringRuleSet ScoringRuleSet? @relation(fields: [scoringRuleSetId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  eventCategories  EventCategory[]
  registrations    Registration[]
  credentials      Credential[]
  batches          StageBatch[]
  panels           JudgePanel[]
  results          Result[]
  documents        EventDocument[]
  posts            Post[]
  sponsorships     Sponsorship[]
  proHistory       AthleteProHistory[]
  rankingPoints    RankingPoint[]
  muscleWarImports MuscleWarImport[]

  @@index([organizationId, status])
  @@index([startDate])
  overallTitles EventOverallTitle[]
}

model EventDocument {
  id           String   @id @default(cuid())
  eventId      String
  title        String
  fileName     String
  mimeType     String   @default("application/octet-stream")
  storageKey   String   @unique
  sizeBytes    Int      @default(0)
  isPublic     Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("EventDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([eventId])
}

// Catálogo global de categorias oficiais. Novas categorias entram por linha,
// nunca por alteração de código: nada aqui é enum fechado.
model Category {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sex       Sex
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventCategories EventCategory[]
  criteria        ScoreCriterion[]
  rankingPoints   RankingPoint[]
  rankings        Ranking[]

  @@index([active, sortOrder])
  overallTitles EventOverallTitle[]
}

model EventCategory {
  id         String   @id @default(cuid())
  eventId    String
  categoryId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  divisions Division[]

  @@unique([eventId, categoryId])
  @@index([eventId])
}

model Division {
  id              String   @id @default(cuid())
  eventCategoryId String
  name            String
  code            String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  eventCategory EventCategory      @relation(fields: [eventCategoryId], references: [id], onDelete: Cascade)
  classes       CompetitionClass[]

  @@unique([eventCategoryId, code])
  @@index([eventCategoryId])
}

// Classe é a unidade em que se compete e em que se apura resultado.
/// Catálogo de classes da organização.
///
/// As classes de competição (`CompetitionClass`) existem por divisão de cada
/// evento — servem para montar a prova, mas não respondem "esta classe conta
/// para o Super Overall?" fora dela. A importação de pontuações, que traz a
/// classe como texto e não está presa a um evento do MCI, ficaria sem onde
/// resolver a elegibilidade.
///
/// Este catálogo é esse lugar: o operador cria, edita e desativa classes aqui,
/// marcando quais alimentam o Super Overall. O motor de pontuação lê a marca —
/// nunca o código "OPEN" — e por isso uma classe nova entra sem alteração de
/// programa.
///
/// REGRA HOMOLOGADA: Estreante, Novice, Open e Master pontuam no campeonato;
/// somente OPEN é elegível ao Super Overall anual.
model ClassCatalog {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  superOverallEligible Boolean @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model CompetitionClass {
  id             String   @id @default(cuid())
  divisionId     String
  name           String
  code           String
  minAge         Int?
  maxAge         Int?
  // Limites de peso em gramas: inteiro evita erro de arredondamento na
  // comparação com a pesagem, que também é gravada em gramas.
  minWeightGrams Int?
  maxWeightGrams Int?
  minHeightCm    Int?
  /// Se os pontos desta classe entram no ranking classificatório do Super
  /// Overall anual. REGRA HOMOLOGADA: todas as classes pontuam no campeonato,
  /// mas só a OPEN alimenta o Super Overall. A distinção é ATRIBUTO DA CLASSE,
  /// nunca o código "OPEN" escrito no motor — é o que permite ao operador criar
  /// e desativar classes sem tocar em programa.
  superOverallEligible Boolean @default(false)
  /// Classe desativada some das novas inscrições e não é oferecida, mas os
  /// resultados já apurados nela continuam válidos.
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  division          Division           @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  rules             CategoryRule[]
  registrationItems RegistrationItem[]
  batches           StageBatch[]
  judgingSessions   JudgingSession[]
  results           Result[]

  @@unique([divisionId, code])
  @@index([divisionId])
  rankingPoints RankingPoint[]
}

model CategoryRule {
  id      String @id @default(cuid())
  classId String
  key     String
  value   String

  competitionClass CompetitionClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, key])
}

// ============================================================================
// INSCRIÇÕES
// ============================================================================

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
}

model Registration {
  id            String             @id @default(cuid())
  eventId       String
  athleteId     String
  affiliationId String?
  status        RegistrationStatus @default(PENDING)
  notes         String?
  createdById   String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete     Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  affiliation Affiliation? @relation(fields: [affiliationId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("RegistrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User?        @relation("RegistrationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  items       RegistrationItem[]
  checkIn     CheckIn?
  weighIns    WeighIn[]
  credentials Credential[]

  @@unique([eventId, athleteId])
  @@index([eventId, status])
  @@index([athleteId])
}

model RegistrationItem {
  id             String             @id @default(cuid())
  registrationId String
  classId        String
  status         RegistrationStatus @default(PENDING)
  bibNumber      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  registration     Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  competitionClass CompetitionClass @relation(fields: [classId], references: [id], onDelete: Restrict)

  stageOrders   StageOrder[]
  scores        JudgingScore[]
  resultEntries ResultEntry[]

  @@unique([registrationId, classId])
  @@index([classId, status])
}

// ============================================================================
// OPERAÇÃO: CHECK-IN, PESAGEM, CREDENCIAMENTO, PALCO
// ============================================================================

enum CheckInStatus {
  CHECKED_IN
  CANCELLED
}

model CheckIn {
  id             String        @id @default(cuid())
  registrationId String        @unique
  status         CheckInStatus @default(CHECKED_IN)
  operatorId     String?
  device         String?
  checkedInAt    DateTime      @default(now())
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  operator     User?        @relation("CheckInOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([status])
}

model WeighIn {
  id             String   @id @default(cuid())
  registrationId String
  weightGrams    Int
  heightCm       Int?
  operatorId     String?
  device         String?
  notes          String?
  measuredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  operator     User?        @relation("WeighInOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([registrationId, measuredAt])
}

enum CredentialType {
  ATHLETE
  COACH
  STAFF
  JUDGE
  MEDIA
  PHOTOGRAPHER
  SPONSOR
  GUEST
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

model Credential {
  id             String           @id @default(cuid())
  eventId        String
  type           CredentialType
  holderName     String
  registrationId String?
  code           String           @unique
  status         CredentialStatus @default(ACTIVE)
  issuedAt       DateTime         @default(now())
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration?    @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  scans        CredentialScan[]

  @@index([eventId, type])
  @@index([status])
}

model CredentialScan {
  id           String   @id @default(cuid())
  credentialId String
  gate         String?
  scannedById  String?
  accepted     Boolean  @default(true)
  reason       String?
  scannedAt    DateTime @default(now())

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  scannedBy  User?      @relation("CredentialScanner", fields: [scannedById], references: [id], onDelete: SetNull)

  @@index([credentialId, scannedAt])
}

enum BatchStatus {
  SCHEDULED
  CALLED
  ON_STAGE
  DONE
  CANCELLED
}

model StageBatch {
  id          String      @id @default(cuid())
  eventId     String
  classId     String
  name        String
  scheduledAt DateTime?
  status      BatchStatus @default(SCHEDULED)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  competitionClass CompetitionClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  orders           StageOrder[]
  sessions         JudgingSession[]

  @@index([eventId, status])
  @@index([classId])
}

enum StageOrderStatus {
  WAITING
  CALLED
  PRESENT
  ABSENT
}

model StageOrder {
  id                 String           @id @default(cuid())
  batchId            String
  registrationItemId String
  position           Int
  status             StageOrderStatus @default(WAITING)
  calledAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  batch            StageBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  registrationItem RegistrationItem @relation(fields: [registrationItemId], references: [id], onDelete: Cascade)

  @@unique([batchId, registrationItemId])
  @@unique([batchId, position])
  @@index([batchId])
}

// ============================================================================
// JULGAMENTO
// ============================================================================

enum PanelJudgeRole {
  HEAD
  JUDGE
}

model JudgePanel {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judges   PanelJudge[]
  sessions JudgingSession[]

  @@unique([eventId, name])
}

model PanelJudge {
  id        String         @id @default(cuid())
  panelId   String
  judgeId   String
  seat      Int
  role      PanelJudgeRole @default(JUDGE)
  createdAt DateTime       @default(now())

  panel JudgePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  judge User       @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([panelId, judgeId])
  @@unique([panelId, seat])
  @@index([judgeId])
}

enum JudgingRound {
  PREJUDGING
  COMPARISON
  FINALS
}

enum JudgingSessionStatus {
  OPEN
  SCORING
  CLOSED
}

model JudgingSession {
  id        String               @id @default(cuid())
  classId   String
  panelId   String
  batchId   String?
  round     JudgingRound         @default(PREJUDGING)
  status    JudgingSessionStatus @default(OPEN)
  openedAt  DateTime             @default(now())
  closedAt  DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  competitionClass CompetitionClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  panel            JudgePanel       @relation(fields: [panelId], references: [id], onDelete: Restrict)
  batch            StageBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  scores           JudgingScore[]

  @@unique([classId, round])
  @@index([status])
}

// Critérios de avaliação por categoria. São descritivos e auditáveis; a
// apuração oficial usa colocação (relative placement), não a soma de notas.
model ScoreCriterion {
  id         String  @id @default(cuid())
  categoryId String?
  code       String
  name       String
  weight     Int     @default(1)
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  category Category?               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   JudgingScoreCriterion[]

  @@unique([categoryId, code])
}

// Uma linha por juiz e por atleta na sessão: a colocação que aquele juiz deu.
model JudgingScore {
  id                 String    @id @default(cuid())
  sessionId          String
  judgeId            String
  registrationItemId String
  placing            Int
  notes              String?
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  session          JudgingSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  judge            User                    @relation("ScoreJudge", fields: [judgeId], references: [id], onDelete: Restrict)
  registrationItem RegistrationItem        @relation(fields: [registrationItemId], references: [id], onDelete: Cascade)
  criteria         JudgingScoreCriterion[]

  // Um juiz não repete a mesma colocação dentro da mesma sessão, e dá uma
  // única colocação por atleta. As duas constraints são o que impede uma
  // apuração ambígua.
  @@unique([sessionId, judgeId, registrationItemId])
  @@unique([sessionId, judgeId, placing])
  @@index([sessionId])
}

model JudgingScoreCriterion {
  id          String @id @default(cuid())
  scoreId     String
  criterionId String
  value       Int

  score     JudgingScore   @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  criterion ScoreCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([scoreId, criterionId])
}

// ============================================================================
// APURAÇÃO
//
// O método de apuração e os desempates são configuração explícita do
// organizador, nunca regra inventada pelo código. Se nenhum critério
// configurado resolver o empate, o resultado sai como TIE_UNRESOLVED.
// ============================================================================

enum TabulationMethod {
  RELATIVE_PLACEMENT_SUM
}

enum TieBreaker {
  HEAD_JUDGE_PLACING
  COUNT_BACK
  SUM_WITHOUT_DROP
}

model ScoringRuleSet {
  id                   String           @id @default(cuid())
  name                 String           @unique
  method               TabulationMethod @default(RELATIVE_PLACEMENT_SUM)
  // Descarte da maior e da menor colocação, aplicado apenas quando o painel
  // tem ao menos `dropHighLowMinJudges` juízes. Desligado por padrão: o
  // descarte é decisão de regulamento, não default do sistema.
  dropHighLow          Boolean          @default(false)
  dropHighLowMinJudges Int              @default(7)
  tieBreakers          TieBreaker[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  events  Event[]
  seasons RankingSeason[]
}

enum ResultStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

model Result {
  id               String       @id @default(cuid())
  eventId          String
  classId          String
  status           ResultStatus @default(DRAFT)
  version          Int          @default(1)
  // Assinatura determinística da entrada de apuração. Recalcular com os
  // mesmos votos produz o mesmo checksum; qualquer divergência indica que a
  // entrada mudou.
  checksum         String
  hasUnresolvedTie Boolean      @default(false)
  computedAt       DateTime     @default(now())
  publishedAt      DateTime?
  publishedById    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  competitionClass CompetitionClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  publishedBy      User?            @relation("ResultPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  entries       ResultEntry[]
  versions      ResultVersion[]
  rankingPoints RankingPoint[]

  @@unique([eventId, classId])
  @@index([status])
}

enum ResultEntryStatus {
  RANKED
  TIE_UNRESOLVED
  DISQUALIFIED
  ABSENT
}

model ResultEntry {
  id                 String            @id @default(cuid())
  resultId           String
  registrationItemId String
  athleteId          String
  placing            Int?
  status             ResultEntryStatus @default(RANKED)
  // Soma das colocações efetivamente considerada na apuração.
  score              Int
  // Soma sem descarte, guardada para desempate e auditoria.
  rawScore           Int
  // Contagem de colocações por posição (countback), em JSON, para tornar a
  // apuração reproduzível sem reabrir as fichas dos juízes.
  breakdown          Json
  createdAt          DateTime          @default(now())

  result           Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)
  registrationItem RegistrationItem @relation(fields: [registrationItemId], references: [id], onDelete: Cascade)
  athlete          Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([resultId, registrationItemId])
  @@index([athleteId])
  @@index([resultId, placing])
}

model ResultVersion {
  id          String   @id @default(cuid())
  resultId    String
  version     Int
  reason      String
  snapshot    Json
  createdById String?
  createdAt   DateTime @default(now())

  result    Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ResultVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([resultId, version])
  @@index([resultId])
}

// ============================================================================
// RANKING E TEMPORADAS
// ============================================================================

enum SeasonStatus {
  OPEN
  CLOSED
}

model RankingSeason {
  id               String       @id @default(cuid())
  organizationId   String
  name             String
  year             Int
  startDate        DateTime?
  endDate          DateTime?
  status           SeasonStatus @default(OPEN)
  scoringRuleSetId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scoringRuleSet  ScoringRuleSet?     @relation(fields: [scoringRuleSetId], references: [id], onDelete: SetNull)
  events          Event[]
  pointsRules     RankingPointsRule[]
  points          RankingPoint[]
  rankings        Ranking[]
  externalResults ExternalResult[]
  imports         MuscleWarImport[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

// Tabela de pontos por colocação. É dado, não código: nenhuma pontuação é
// embutida no sistema.
model RankingPointsRule {
  id        String   @id @default(cuid())
  seasonId  String
  placing   Int
  points    Int
  createdAt DateTime @default(now())

  season RankingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, placing])
}

enum PointSource {
  EVENT
  MUSCLEWAR
}

// Cada ponto do ranking é rastreável até a sua origem: nunca existe pontuação
// sem linha de proveniência.
model RankingPoint {
  id               String      @id @default(cuid())
  seasonId         String
  athleteId        String
  categoryId       String?
  source           PointSource
  eventId          String?
  resultId         String?
  externalResultId String?     @unique
  placing          Int?
  // Decomposição obrigatória para auditoria: o total precisa ser reconstituível
  // a partir das parcelas, não apenas conferido no agregado.
  //   points = placementPoints + overallBonus
  placementPoints  Int         @default(0)
  overallBonus     Int         @default(0)
  isOverallChampion Boolean    @default(false)
  /// Se este lançamento entra no ranking classificatório do Super Overall.
  /// Resolvido no momento da atribuição, a partir da classe — e gravado, para
  /// que uma mudança futura na configuração da classe não reescreva a
  /// história de um campeonato já encerrado.
  superOverallEligible Boolean @default(false)
  /// Pontos do CAMPEONATO: toda classe pontua, pela tabela da temporada.
  points           Int
  /// Pontos elegíveis ao SUPER OVERALL anual: iguais a `points` onde a classe
  /// era elegível, zero nas demais. Gravado, e não deduzido na leitura, para
  /// que as duas métricas nunca sejam confundidas uma com a outra — e para que
  /// o bônus de Overall siga a elegibilidade da participação que o originou.
  superOverallPoints Int      @default(0)
  // Equipe do atleta no momento da atribuição. Guardada aqui, e não lida do
  // cadastro na hora da consulta, para que uma troca de equipe depois do
  // evento não reescreva a história do ranking.
  teamId           String?
  /// Empresa da equipe no momento da atribuição. Gravada, e não deduzida na
  /// leitura: trocar a equipe de empresa depois do evento não pode reescrever
  /// a história do ranking.
  companyId        String?
  classId          String?
  // Versão do resultado que originou o ponto: permite conferir que o ranking
  // reflete a versão válida, e não uma anterior.
  resultVersion    Int?
  awardedById      String?
  awardedAt        DateTime    @default(now())
  createdAt        DateTime    @default(now())

  season         RankingSeason   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  athlete        Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  result         Result?         @relation(fields: [resultId], references: [id], onDelete: SetNull)
  externalResult ExternalResult? @relation(fields: [externalResultId], references: [id], onDelete: SetNull)
  team           Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  competitionClass CompetitionClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  awardedBy      User?             @relation("RankingPointAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)

  // Um mesmo resultado de evento não pontua duas vezes para o mesmo atleta na
  // mesma temporada.
  @@unique([seasonId, athleteId, resultId])
  @@index([seasonId, athleteId])
  @@index([seasonId, teamId])
  @@index([seasonId, companyId])
  @@index([source])
}

// Agregado materializado, recalculado a partir de RankingPoint.
/// Título Overall de um evento.
///
/// REGRA HOMOLOGADA: o campeão Overall recebe +10 pontos, somados aos pontos da
/// colocação (não os substituem), e o número de títulos Overall é o primeiro
/// critério de desempate do ranking.
///
/// PENDING HOMOLOGATION: COMO o campeão Overall é determinado — entre quais
/// classes ele é disputado, se há um Overall por categoria ou um por evento, e
/// se resulta de apuração ou de decisão do painel — não foi definido. Por isso
/// o título é REGISTRADO pela organização, e não calculado: aplicar o bônus a
/// partir de um critério que ninguém homologou seria inventar regulamento.
model EventOverallTitle {
  id          String   @id @default(cuid())
  eventId     String
  athleteId   String
  /// Recorte do título. Nulo = Overall do evento inteiro. Enquanto o critério
  /// não é homologado, o campo apenas registra o que a organização declarou.
  categoryId  String?
  note        String?
  declaredById String?
  declaredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete    Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  declaredBy User?     @relation("OverallDeclaredBy", fields: [declaredById], references: [id], onDelete: SetNull)

  /// Um título por recorte: declarar de novo substitui, não acumula.
  @@unique([eventId, categoryId])
  @@index([athleteId])
}

model Ranking {
  id          String   @id @default(cuid())
  seasonId    String
  athleteId   String
  categoryId  String?
  totalPoints Int      @default(0)
  eventCount  Int      @default(0)
  // Contadores de desempate. Ficam materializados porque a ordenação depende
  // deles: guardar só o total tornaria o ranking impossível de auditar e de
  // reordenar sem reabrir cada ponto.
  overallWins      Int @default(0)
  firstPlaceCount  Int @default(0)
  secondPlaceCount Int @default(0)
  thirdPlaceCount  Int @default(0)
  fourthPlaceCount Int @default(0)
  fifthPlaceCount  Int @default(0)
  // Empate que a hierarquia oficial não resolveu: os empatados ficam sem
  // posição, como manda a regra, em vez de receberem uma ordem arbitrária.
  tieUnresolved    Boolean @default(false)
  position    Int?
  state       String?
  country     String?
  updatedAt   DateTime @updatedAt

  season   RankingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  athlete  Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([seasonId, athleteId, categoryId])
  @@index([seasonId, totalPoints])
}

// ============================================================================
// MUSCLEWAR — IMPORTAÇÃO DE RESULTADOS EXTERNOS
// ============================================================================

enum ImportSourceType {
  CSV
  JSON
  API
}

enum ImportStatus {
  PENDING
  PREVIEWED
  APPLIED
  REJECTED
}

model MuscleWarImport {
  id             String           @id @default(cuid())
  organizationId String
  seasonId       String?
  eventId        String?
  sourceType     ImportSourceType
  sourceRef      String
  status         ImportStatus     @default(PENDING)
  totalRecords   Int              @default(0)
  matchedCount   Int              @default(0)
  pendingCount   Int              @default(0)
  conflictCount  Int              @default(0)
  duplicateCount Int              @default(0)
  rejectedCount  Int              @default(0)
  appliedCount   Int              @default(0)
  version        Int              @default(1)
  createdById    String?
  appliedById    String?
  appliedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  season       RankingSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  appliedBy    User?          @relation("ImportAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)

  items MuscleWarImportItem[]

  @@index([organizationId, status])
  @@index([createdAt])
}

enum MatchStatus {
  MATCHED
  MATCH_PENDING
  CONFLICT
  DUPLICATE
  IMPORT_REJECTED
  APPLIED
}

model MuscleWarImportItem {
  id               String      @id @default(cuid())
  importId         String
  externalResultId String
  rowNumber        Int
  cpf              String?
  athleteName      String?
  affiliationCode  String?
  categoryCode     String?
  divisionName     String?
  className        String?
  placing          Int?
  /// Campeão Overall informado pela origem. A pontuação (+10) é regra
  /// homologada; QUEM é o campeão continua sendo dado informado, nunca
  /// deduzido pelo sistema.
  isOverallChampion Boolean   @default(false)
  /// Equipe declarada pela origem. `className`, logo acima, é o que resolve a
  /// elegibilidade ao Super Overall contra o catálogo da organização.
  teamName         String?
  companyName      String?
  points           Int?
  eventName        String?
  eventDate        DateTime?
  raw              Json
  matchStatus      MatchStatus @default(MATCH_PENDING)
  reason           String?
  /// Divergência entre a pontuação do arquivo e a calculada pela regra oficial:
  /// { importedPoints, calculatedPoints, difference }. Preenchida junto com o
  /// CONFLICT, para que o operador veja os números e não só a frase.
  pointsMismatch   Json?
  athleteId        String?
  linkedById       String?
  linkedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  import         MuscleWarImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  athlete        Athlete?        @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  externalResult ExternalResult?

  // O mesmo identificador externo não entra duas vezes no mesmo lote.
  @@unique([importId, externalResultId])
  @@index([importId, matchStatus])
}

// Registro canônico de um resultado externo já aplicado. O par
// (source, externalId) é único: reimportar o mesmo resultado não gera segunda
// pontuação — é isto que torna a importação idempotente.
model ExternalResult {
  id           String    @id @default(cuid())
  source       String    @default("MUSCLEWAR")
  externalId   String
  seasonId     String?
  athleteId    String
  categoryCode String?
  className    String?
  placing      Int?
  points       Int       @default(0)
  eventName    String?
  eventDate    DateTime?
  importItemId String?   @unique
  appliedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())

  season       RankingSeason?       @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  athlete      Athlete              @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  importItem   MuscleWarImportItem? @relation(fields: [importItemId], references: [id], onDelete: SetNull)
  rankingPoint RankingPoint?

  @@unique([source, externalId])
  @@index([athleteId])
}

// ============================================================================
// MARCAS, PATROCINADORES, PARCERIAS
//
// Relação esportiva, institucional e de marketing. Nenhum valor monetário é
// armazenado — nem contrato, nem cota, nem repasse.
// ============================================================================

model Brand {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique
  website        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile?
  sponsors      Sponsor[]
  partnerships  AthleteBrandPartnership[]

  @@index([organizationId, active])
}

model Sponsor {
  id             String   @id @default(cuid())
  organizationId String
  brandId        String?
  name           String
  contactEmail   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  socialProfile SocialProfile?
  sponsorships  Sponsorship[]

  @@unique([organizationId, name])
}

enum SponsorshipStatus {
  PENDING
  ACTIVE
  ENDED
}

// Patrocínio de evento, equipe ou atleta. `scope` descreve a natureza do
// apoio em texto; não existe campo de valor por decisão de escopo.
model Sponsorship {
  id        String            @id @default(cuid())
  sponsorId String
  eventId   String?
  teamId    String?
  athleteId String?
  status    SponsorshipStatus @default(ACTIVE)
  scope     String?
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  sponsor Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  event   Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team    Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete Athlete? @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([sponsorId, status])
  @@index([eventId])
}

model AthleteBrandPartnership {
  id        String            @id @default(cuid())
  athleteId String
  brandId   String
  status    SponsorshipStatus @default(PENDING)
  scope     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([athleteId, brandId])
  @@index([status])
}

// ============================================================================
// MCI SOCIAL
// ============================================================================

enum ProfileKind {
  ATHLETE
  COACH
  GYM
  TEAM
  BRAND
  SPONSOR
  FAN
  MEDIA
}

model SocialProfile {
  id          String      @id @default(cuid())
  userId      String?     @unique
  handle      String      @unique
  displayName String
  kind        ProfileKind @default(FAN)
  bio         String?
  avatarKey   String?
  coverKey    String?
  athleteId   String?     @unique
  coachId     String?     @unique
  gymId       String?     @unique
  teamId      String?     @unique
  brandId     String?     @unique
  sponsorId   String?     @unique
  isPrivate   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete Athlete? @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  coach   Coach?   @relation(fields: [coachId], references: [id], onDelete: SetNull)
  gym     Gym?     @relation(fields: [gymId], references: [id], onDelete: SetNull)
  team    Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  brand   Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sponsor Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  posts                   Post[]
  comments                Comment[]
  postLikes               PostLike[]
  commentLikes            CommentLike[]
  shares                  PostShare[]
  saves                   PostSave[]
  followers               Follow[]             @relation("Following")
  following               Follow[]             @relation("Follower")
  stories                 Story[]
  storyViews              StoryView[]
  blocksMade              Block[]              @relation("Blocker")
  blocksReceived          Block[]              @relation("Blocked")
  reportsMade             ContentReport[]      @relation("Reporter")
  conversationMemberships ConversationMember[]
  messages                Message[]
  reactions               MessageReaction[]
  communityMemberships    CommunityMember[]
  sharedInMessages        Message[]            @relation("MessageSharedProfile")

  @@index([kind])
  @@index([displayName])
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

model Post {
  id           String         @id @default(cuid())
  authorId     String
  content      String
  visibility   PostVisibility @default(PUBLIC)
  eventId      String?
  communityId  String?
  likeCount    Int            @default(0)
  commentCount Int            @default(0)
  shareCount   Int            @default(0)
  saveCount    Int            @default(0)
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  author    SocialProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event     Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  community Community?    @relation(fields: [communityId], references: [id], onDelete: Cascade)

  media            PostMedia[]
  comments         Comment[]
  likes            PostLike[]
  shares           PostShare[]
  saves            PostSave[]
  sharedInMessages Message[]   @relation("MessageSharedPost")

  @@index([authorId, createdAt])
  @@index([visibility, createdAt])
  @@index([eventId])
  @@index([communityId, createdAt])
}

enum MediaKind {
  IMAGE
  VIDEO
}

model PostMedia {
  id         String    @id @default(cuid())
  postId     String
  kind       MediaKind
  storageKey String    @unique
  mimeType   String
  sizeBytes  Int       @default(0)
  width      Int?
  height     Int?
  durationMs Int?
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  likeCount Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  SocialProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentThread")
  likes   CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  profileId String
  createdAt DateTime @default(now())

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([profileId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  profileId String
  createdAt DateTime @default(now())

  comment Comment       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([commentId, profileId])
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  profileId String
  comment   String?
  createdAt DateTime @default(now())

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([profileId])
}

model PostSave {
  id        String   @id @default(cuid())
  postId    String
  profileId String
  createdAt DateTime @default(now())

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([profileId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  SocialProfile @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following SocialProfile @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Story {
  id         String    @id @default(cuid())
  authorId   String
  storageKey String    @unique
  mimeType   String
  kind       MediaKind @default(IMAGE)
  caption    String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  author SocialProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  profileId String
  viewedAt  DateTime @default(now())

  story   Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([storyId, profileId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker SocialProfile @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked SocialProfile @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

enum ReportTargetType {
  POST
  COMMENT
  PROFILE
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model ContentReport {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       String
  status       ReportStatus     @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())

  reporter   SocialProfile @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?         @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// ============================================================================
// COMUNIDADES
// ============================================================================

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

model Community {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String?
  visibility  CommunityVisibility @default(PUBLIC)
  rules       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  members CommunityMember[]
  posts   Post[]
}

enum CommunityRole {
  MEMBER
  ADMIN
}

model CommunityMember {
  id          String        @id @default(cuid())
  communityId String
  profileId   String
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  community Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profile   SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([communityId, profileId])
  @@index([profileId])
}

// ============================================================================
// MCI MESSENGER
// ============================================================================

enum ConversationKind {
  DIRECT
  GROUP
}

model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind @default(DIRECT)
  title         String?
  // Chave canônica de conversa direta: os dois ids ordenados. É o que impede
  // duas conversas 1:1 entre as mesmas pessoas.
  directKey     String?          @unique
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
}

enum ConversationRole {
  MEMBER
  ADMIN
}

model ConversationMember {
  id             String           @id @default(cuid())
  conversationId String
  profileId      String
  role           ConversationRole @default(MEMBER)
  lastReadAt     DateTime?
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([conversationId, profileId])
  @@index([profileId, joinedAt])
}

model Message {
  id              String     @id @default(cuid())
  conversationId  String
  senderId        String
  body            String?
  storageKey      String?
  mimeType        String?
  mediaKind       MediaKind?
  sharedPostId    String?
  sharedProfileId String?
  replyToId       String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())

  conversation  Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        SocialProfile     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  sharedPost    Post?             @relation("MessageSharedPost", fields: [sharedPostId], references: [id], onDelete: SetNull)
  sharedProfile SocialProfile?    @relation("MessageSharedProfile", fields: [sharedProfileId], references: [id], onDelete: SetNull)
  replyTo       Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]         @relation("MessageReply")
  reactions     MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  profileId String
  emoji     String
  createdAt DateTime @default(now())

  message Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([messageId, profileId, emoji])
}

// ============================================================================
// NOTIFICAÇÕES E AUDITORIA
// ============================================================================

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  link       String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  userEmail      String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  user User? @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([organizationId, createdAt])
}
