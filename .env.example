# ==========================================================
# MCI Platform — Campeonato Brasileiro Muscle Contest
# Copie para .env e ajuste. NUNCA versione o .env preenchido.
#
# Esta plataforma NÃO é um sistema financeiro: não há variável
# de pagamento, cobrança, provedor, cartão ou carteira, e a
# ausência é verificada por teste.
# ==========================================================

# development | test | production
NODE_ENV=development
PORT=3000

# Banco. PostgreSQL é obrigatório: o RLS da plataforma depende dele e o
# servidor se recusa a subir em produção com outro banco.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/mci?schema=public"

# Banco usado pela suíte de testes. Se ausente, a suíte usa DATABASE_URL.
# TEST_DATABASE_URL="postgresql://usuario:senha@localhost:5432/mci_test?schema=public"

# Conexão do papel de aplicação, para o qual o RLS é obrigatório.
# Criado por scripts/provision-app-role.sql.
# RLS_DATABASE_URL="postgresql://mci_app:senha@localhost:5432/mci?schema=public"

# Assinatura do JWT. Em produção precisa ter 32+ caracteres e NÃO pode ser
# um valor de exemplo — o servidor se recusa a subir com placeholder.
# Gerar com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor-em-producao"
JWT_EXPIRES_IN=12h

# Custo do hash de senha. Abaixo de 10 o servidor recusa produção.
BCRYPT_ROUNDS=12

# Origens liberadas no CORS, separadas por vírgula. Sem curinga em produção.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Fuso padrão de novas organizações e eventos. Cada evento carrega o seu;
# nenhum cálculo do domínio assume fuso fixo.
DEFAULT_TIMEZONE=America/Sao_Paulo

# Armazenamento de arquivos. 'local' grava em disco; outros drivers são
# registrados em src/services/storageService.js.
#
# ATENÇÃO em produção: 'local' grava no disco do próprio contêiner. Sem volume
# persistente montado, todo upload — documento de atleta, foto, mídia de
# mensagem — se perde no primeiro redeploy, e a perda só aparece quando alguém
# vai buscar o arquivo. O servidor recusa subir nessa combinação a menos que o
# risco seja assumido explicitamente com ALLOW_LOCAL_STORAGE=true (o que só é
# correto quando há volume persistente de verdade).
STORAGE_DRIVER=local
ALLOW_LOCAL_STORAGE=false
STORAGE_DIR=./uploads

# Provedor de objetos (STORAGE_DRIVER=s3). Serve S3, MinIO, Cloudflare R2,
# DigitalOcean Spaces e Backblaze B2 — todos falam o mesmo protocolo.
# Nenhum valor tem padrão: em produção o servidor recusa subir sem os quatro.
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# S3_REGION=us-east-1
# S3_BUCKET=mci-arquivos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Caminho (host/bucket/chave) é o de MinIO e da maioria dos compatíveis;
# false usa virtual-hosted (bucket.host/chave), padrão do S3 moderno.
# S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=10485760
MEDIA_MAX_BYTES=52428800

# Duração de um story antes de expirar (horas).
STORY_TTL_HOURS=24

# Quantos proxies existem ENTRE o cliente e a aplicação (nginx, ALB, CDN...).
# O Express usa isto para achar o endereço real dentro de X-Forwarded-For.
# Errar não dá erro: só faz o limitador contar o endereço errado. Número maior
# que a realidade deixa o cliente escolher o próprio endereço e contornar o
# limite; use 0 se a aplicação estiver exposta diretamente.
TRUST_PROXY_HOPS=1

# Limite de requisições. Ligado por padrão apenas em produção.
RATE_LIMIT_ENABLED=false

# silent | error | warn | info | debug
LOG_LEVEL=debug
