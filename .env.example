# ==========================================================
# MCI Campeonatos — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env preenchido.
# ==========================================================

# development | test | production
NODE_ENV=development
PORT=3000

# Banco. PostgreSQL em todos os ambientes — desenvolvimento, teste e produção
# usam o mesmo motor, para que um comportamento só apareça em produção nunca.
# O docker-compose sobe um PostgreSQL local com exatamente estas credenciais.
DATABASE_URL="postgresql://mci:mci@localhost:5432/mci?schema=public"

# Assinatura do JWT. Em produção precisa ter 32+ caracteres e NÃO pode ser
# este valor — o servidor se recusa a subir com o placeholder.
# Gerar com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN=12h

# Origens liberadas no CORS, separadas por vírgula. Sem curinga em produção.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Armazenamento de arquivos. 'local' grava em disco; outros drivers são
# registrados em src/services/storageService.js.
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# Pagamento. 'sandbox' é o provedor de DESENVOLVIMENTO: não move dinheiro e
# não opera em produção sem ALLOW_SANDBOX_PAYMENTS=true assumido de propósito.
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET="sandbox-webhook-secret"
ALLOW_SANDBOX_PAYMENTS=false

# Prazo para concluir o pagamento antes de o pedido expirar (minutos).
ORDER_EXPIRATION_MINUTES=60

# Limite de requisições. Ligado por padrão apenas em produção.
RATE_LIMIT_ENABLED=false

# silent | error | warn | info | debug
LOG_LEVEL=debug
