# Dependências
node_modules/
.pnpm-store/

# Builds
.next/
dist/
build/
out/
.expo/
web-build/

# Ambiente e segredos
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Cache
.cache/
.turbo/
.nx/
coverage/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Prisma
prisma/*.db
prisma/*.db-journal
# Banco fora de prisma/ (shadow database, cópia de depuração) também fica de
# fora: um .db versionado por engano carrega dados reais de usuário.
*.db
*.db-journal
*.sqlite
*.sqlite3

# Temporários
tmp/
temp/

# Uploads locais
uploads/
uploads-test/

# Certificados e chaves
*.pem
*.key
*.crt

# Ferramentas do ambiente de desenvolvimento
# Instaladas por npx skills add (caveman). São do ambiente de quem desenvolve,
# não do produto MCI: não contêm código, dados nem design da plataforma.
# Mantidas em disco, fora do versionamento.
.agents/
.claude/
skills-lock.json

# Dumps do banco: dados reais, nunca versionados.
backups/
# O DIRETÓRIO DE ARMAZENAMENTO DO PREVIEW. `STORAGE_DIR=./uploads-preview` é o
# que o workflow e a réplica local usam, e é ali que a foto do treinador é
# gravada quando o ambiente roda. Quatro `.webp` sintéticos chegaram a ser
# rastreados por um `git add -A` meu: objeto de execução não pertence ao git, e
# num repositório público ainda menos.
uploads-preview/
uploads-gate/
uploads-homolog/
uploads-dr*/
uploads-recuperado/
uploads-desastre/

# BACKUP DA RODADA DE MUTAÇÃO — nunca versionado.
#
# `scripts/qa/mutantes-*.mjs` salva `<arquivo>.mutante-bak` antes de aplicar cada
# mutante e restaura depois. Um `git add -A` dado com a rodada em curso capturava
# o backup E o arquivo MUTADO: aconteceu, e o mutante TE-F1 — que apaga
# `status: 'APPROVED'` da lista de autorização da federação, violando R-03 — foi
# commitado e empurrado. Esta linha impede a metade do acidente que é versionar o
# backup; `tests/higiene-repositorio.test.mjs` recusa o resto.
*.mutante-bak
